{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "purchasables",
  "description": "The resolver contract every purchasable type implements under its own Function name (STAPEL_ORDERS['PURCHASABLE_TYPES'][type]['resolve'], e.g. listings.purchasables). Input: a keyed batch of purchasable keys. Output ($defs.result): {key: item}; an absent key is unknown. Prices are 2-dp decimal strings, never floats. stapel-orders validates every reply against $defs.result when STAPEL_COMM['VALIDATE_SCHEMAS'] is on.",
  "type": "object",
  "properties": {
    "keys": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 255},
      "minItems": 1,
      "maxItems": 100
    }
  },
  "required": ["keys"],
  "additionalProperties": false,
  "$defs": {
    "item": {
      "type": "object",
      "properties": {
        "title": {"type": "string"},
        "price": {"type": "string", "pattern": "^[0-9]{1,10}(\\.[0-9]{1,2})?$"},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "available": {"type": "boolean"},
        "max_quantity": {"type": ["integer", "null"], "minimum": 0},
        "seller_id": {"type": ["string", "null"]},
        "image": {"type": ["string", "null"]},
        "url": {"type": ["string", "null"]}
      },
      "required": ["title", "price", "currency", "available"],
      "additionalProperties": true
    },
    "result": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/item"}
    }
  }
}

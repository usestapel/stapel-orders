{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "orders.order.placed",
  "description": "An order was placed at checkout. Lines ride the event (ids, quantities and prices only — no contact or address) so a product owner can decrement stock and a seller can be told. Key = order id. Money is a decimal string.",
  "type": "object",
  "properties": {
    "order_id": {"type": "string"},
    "user_id": {"type": "string"},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "total": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$"},
    "placed_at": {"type": "string", "format": "date-time"},
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "purchasable_type": {"type": "string", "maxLength": 32},
          "purchasable_key": {"type": "string", "maxLength": 255},
          "quantity": {"type": "integer", "minimum": 1},
          "unit_price": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$"},
          "seller_id": {"type": ["string", "null"]}
        },
        "required": ["purchasable_type", "purchasable_key", "quantity", "unit_price", "seller_id"],
        "additionalProperties": false
      }
    }
  },
  "required": ["order_id", "user_id", "currency", "total", "placed_at", "lines"],
  "additionalProperties": false
}
